# --- Database ---
DATABASE_URL=postgres://buddy:buddy@localhost:5432/buddy

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Sessions (Phase 2) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# --- Anthropic AI (Phase 3) — server-side only, never expose to client ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Stripe (Phase 4) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CODICE_FISCALE=
